{
  "name": "ai-sdlc",
  "version": "0.2.0",
  "description": "Provider-neutral agent SDLC pipeline: one source of truth compiled to Claude Code and Codex",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedyx/ai-sdlc.git"
  },
  "bugs": {
    "url": "https://github.com/cedyx/ai-sdlc/issues"
  },
  "homepage": "https://github.com/cedyx/ai-sdlc#readme",
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "sdlc",
    "code-generation"
  ],
  "type": "module",
  "bin": {
    "ai-sdlc": "./dist/cli.js"
  },
  "files": [
    "dist",
    ".ai",
    "!.ai/epics",
    "scripts",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "npm run build && node dist/cli.js generate",
    "prepare": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
